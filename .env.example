# CCTI deployment environment
# Copy this file to .env and fill in real values before running.
# All values shown are the defaults used when the variable is not set.

# MISP feed source
# Generate the key in MISP: Admin -> Auth keys -> Add authentication key
MISP_BASE_URL=https://misp.cti-lab.me
MISP_API_KEY=replace-with-your-misp-api-key
MISP_EVENT_LIMIT=200

# SSL verification for MISP connection.
# Set MISP_VERIFY_SSL=false ONLY for self-signed certs in a lab environment.
# In production, leave this unset (defaults to true) or point to a CA bundle.
# MISP_VERIFY_SSL=false
# MISP_CA_BUNDLE=/path/to/ca-bundle.crt

# At-rest encryption for sensitive pipeline outputs (raw MISP events,
# recommendation files). Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset for local development (encryption is skipped).
# CCTI_ENCRYPTION_KEY=replace-with-generated-fernet-key

# API service
API_PORT=8000
API_LOG_LEVEL=INFO
DASHBOARD_ORIGINS=*
DASHBOARD_ALLOW_CREDENTIALS=true

# RAG chat feature
# Get an API key at https://console.groq.com.
# If left unset the dashboard still works — only the AI chat tab is disabled.
# GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Vector/RAG settings
CHROMA_PERSIST_DIR=/app/cti_microservice_v1/vector_store
COLLECTION_NAME=soc_threat_intel
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVER_K=4

# Recommendation engine tuning (optional — these are the defaults)
# CTI_OLLAMA_MODEL=deepseek-r1:14b
# CTI_REC_MIN_SCORE=1.0
# CTI_REC_TOP_N=20
# CTI_REC_CPE_BOOST=0.25
# CTI_REC_MITRE_BOOST=0.20
# CTI_REC_MITRE_CAP=0.60
# CTI_REC_SPECIFICITY_FLOOR=0.35

# Data path overrides (for development/testing only — leave unset in production)
# CCTI_CLEANED_DIR=/path/to/custom/cleaned/dir
# CCTI_NER_FILE=/path/to/custom/ner_results.json
